---
import { date } from '../lib/format.js';

const { article, size = 'thumb' } = Astro.props;
const id = article.id;
const w = size === 'full' ? article.data.fullW : article.data.thumbW;
const h = size === 'full' ? article.data.fullH : article.data.thumbH;
---

<li class="card">
  <a href={`/articles/${id}/`}>
    <picture><source srcset={`/assets/covers/${id}-${size}.webp`} type="image/webp"><img
      src={`/assets/covers/${id}-${size}.jpg`} width={w} height={h} alt=""></picture>
    <h3>{article.data.title}</h3>
    <p class="byline">{article.data.author}<br>{date(article.data.date)}</p>
  </a>
</li>
